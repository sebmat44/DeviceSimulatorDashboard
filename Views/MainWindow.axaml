<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DeviceSimulatorDashboard.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DeviceSimulatorDashboard.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="DeviceSimulatorDashboard">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- StackPanel układa kontrolki z góry na dół, jedna pod drugą -->
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
    
    <!-- Pole tekstowe podpięte pod naszą zmienną (ConnectionStatus) -->
    <TextBlock Text="{Binding ConnectionStatus}" 
               FontSize="24" 
               FontWeight="Bold"
               HorizontalAlignment="Center" />

    <!-- Przycisk podpięty pod wygenerowaną komendę (ConnectToDeviceCommand) -->
    <Button Content="Połącz z symulatorem"
            Command="{Binding ConnectToDeviceCommand}"
            Padding="15, 10"
            HorizontalAlignment="Center" />
            
</StackPanel>

</Window>
